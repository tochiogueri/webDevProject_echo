# Copy this file to .env before running.
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/echo_music
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# Optional: get an API token at https://audd.io/
# Needed for real music recognition from recordings/uploads.
AUDD_API_TOKEN=

# When deployed behind HTTPS, set NODE_ENV=production.
NODE_ENV=development